)

INV_SBOX = bytearray(256)

for i, v in enumerate(SBOX):
    INV_SBOX[v] = i

RCON = [
    0x00, 0x01, 0x02, 0x04,
    0x08, 0x10, 0x20, 0x40,
    0x80, 0x1B, 0x36
]

def read_input(prompt):
    value = input(prompt)

    if value.strip() == "0":
        sys.exit(0)

    return value

def xtime(a):
    return ((a << 1) ^ (0x11B if a & 0x80 else 0)) & 0xFF

def mul(a, b):
    result = 0

    while b:
        if b & 1:
            result ^= a

        a = xtime(a)
        b >>= 1

    return result

def expand_key(key):
    words = [list(key[i:i + 4]) for i in range(0, 32, 4)]

    for i in range(8, 60):
        temp = words[i - 1][:]

        if i % 8 == 0:
            temp = temp[1:] + temp[:1]
            temp = [SBOX[x] for x in temp]
            temp[0] ^= RCON[i // 8]

        elif i % 8 == 4:
            temp = [SBOX[x] for x in temp]

        words.append([
            words[i - 8][j] ^ temp[j]
            for j in range(4)
        ])

    return [
        sum(words[i:i + 4], [])
        for i in range(0, 60, 4)
    ]

def add_round_key(state, key):
    return [a ^ b for a, b in zip(state, key)]

def sub_bytes(state):
    return [SBOX[x] for x in state]

def inv_sub_bytes(state):
    return [INV_SBOX[x] for x in state]

def shift_rows(state):
    result = state[:]

    for row in range(4):
        values = [state[row + 4 * col] for col in range(4)]
        values = values[row:] + values[:row]

        for col in range(4):
            result[row + 4 * col] = values[col]

    return result

def inv_shift_rows(state):
    result = state[:]

    for row in range(4):
        values = [state[row + 4 * col] for col in range(4)]

        if row:
            values = values[-row:] + values[:-row]

        for col in range(4):
            result[row + 4 * col] = values[col]

    return result

def mix_columns(state):
    result = state[:]

    for col in range(4):
        a = state[col * 4:col * 4 + 4]

        result[col * 4] = (
            mul(a[0], 2) ^
            mul(a[1], 3) ^
            a[2] ^
            a[3]
        )

        result[col * 4 + 1] = (
            a[0] ^
            mul(a[1], 2) ^
            mul(a[2], 3) ^
            a[3]
        )

        result[col * 4 + 2] = (
            a[0] ^
            a[1] ^
            mul(a[2], 2) ^
            mul(a[3], 3)
        )

        result[col * 4 + 3] = (
            mul(a[0], 3) ^
            a[1] ^
            a[2] ^
            mul(a[3], 2)
        )

    return result

def inv_mix_columns(state):
    result = state[:]

    for col in range(4):
        a = state[col * 4:col * 4 + 4]

        result[col * 4] = (
            mul(a[0], 14) ^
            mul(a[1], 11) ^
            mul(a[2], 13) ^
            mul(a[3], 9)
        )

        result[col * 4 + 1] = (
            mul(a[0], 9) ^
            mul(a[1], 14) ^
            mul(a[2], 11) ^
            mul(a[3], 13)
        )

        result[col * 4 + 2] = (
            mul(a[0], 13) ^
            mul(a[1], 9) ^
            mul(a[2], 14) ^
            mul(a[3], 11)
        )

        result[col * 4 + 3] = (
            mul(a[0], 11) ^
            mul(a[1], 13) ^
            mul(a[2], 9) ^
            mul(a[3], 14)
        )

    return result

def encrypt_block(block, round_keys):
    state = list(block)
    state = add_round_key(state, round_keys[0])

    for i in range(1, 14):
        state = sub_bytes(state)
        state = shift_rows(state)
        state = mix_columns(state)
        state = add_round_key(state, round_keys[i])

    state = sub_bytes(state)
    state = shift_rows(state)
    state = add_round_key(state, round_keys[14])

    return bytes(state)

def decrypt_block(block, round_keys):
    state = list(block)
    state = add_round_key(state, round_keys[14])

    for i in range(13, 0, -1):
        state = inv_shift_rows(state)
        state = inv_sub_bytes(state)
        state = add_round_key(state, round_keys[i])
        state = inv_mix_columns(state)

    state = inv_shift_rows(state)
    state = inv_sub_bytes(state)
    state = add_round_key(state, round_keys[0])

    return bytes(state)

def xor_bytes(a, b):
    return bytes(x ^ y for x, y in zip(a, b))

def pad(data):
    size = 16 - len(data) % 16
    return data + bytes([size]) * size

def unpad(data):
    if not data:
        raise ValueError

    size = data[-1]

    if size < 1 or size > 16:
        raise ValueError

    if data[-size:] != bytes([size]) * size:
        raise ValueError

    return data[:-size]

def encrypt(data, key, iv):
    round_keys = expand_key(key)
    data = pad(data)

    result = bytearray()
    previous = iv

    for i in range(0, len(data), 16):
        block = xor_bytes(data[i:i + 16], previous)
        block = encrypt_block(block, round_keys)

        result.extend(block)
        previous = block

    return bytes(result)

def decrypt(data, key, iv):
    if not data or len(data) % 16:
        raise ValueError

    round_keys = expand_key(key)

    result = bytearray()
    previous = iv

    for i in range(0, len(data), 16):
        block = data[i:i + 16]
        decoded = decrypt_block(block, round_keys)

        result.extend(xor_bytes(decoded, previous))
        previous = block

    return unpad(bytes(result))

def read_hex(prompt):
    while True:
        value = "".join(read_input(prompt).split())

        try:
            if value:
                return bytes.fromhex(value)
        except ValueError:
            pass

        print("Invalid")

def encrypt_mode():
    text = read_input("Text  : ")

    key = secrets.token_bytes(32)
    iv = secrets.token_bytes(16)

    cipher = encrypt(
        text.encode("utf-8"),
        key,
        iv
    )

    print()
    print("Key   :", key.hex())
    print("IV    :", iv.hex())
    print("Cipher:", cipher.hex())
    print()

def decrypt_mode():
    while True:
        key = read_hex("Key   : ")

        if len(key) == 32:
            break

        print("Invalid")

    while True:
        iv = read_hex("IV    : ")

        if len(iv) == 16:
            break

        print("Invalid")

    cipher = read_hex("Cipher: ")

    try:
        text = decrypt(cipher, key, iv).decode("utf-8")

        print()
        print("Text  :", text)
        print()

    except (ValueError, UnicodeDecodeError):
        print()
        print("Decrypt failed")
        print()

def main():
    while True:
        print("1. Encrypt")
        print("2. Decrypt")
        print("3. Exit")

        choice = read_input("> ").strip()

        if choice == "1":
            encrypt_mode()

        elif choice == "2":
            decrypt_mode()

        elif choice == "3":
            break

        else:
            print()

if __name__ == "__main__":
    main()
